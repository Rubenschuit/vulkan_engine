#ifndef VE_CONSTANTS_SLANGH
#define VE_CONSTANTS_SLANGH

// Keep in sync with engine/src/ve_config.hpp
#define MAX_LIGHTS          320
#define MAX_SHADOW_LIGHTS   4
#define MAX_DIR_LIGHTS      4
#define MAX_SPOT_LIGHTS     32
#define NUM_CSM_CASCADES    3

// Clustered forward shading (keep in sync with ve_config.hpp)
#define CLUSTER_TILE_SIZE        64
#define CLUSTER_Z_SLICES         24
#define MAX_LIGHTS_PER_CLUSTER   64
#define MAX_CLUSTER_LIGHTS       1024

// GPU-driven culling (keep in sync with ve_config.hpp)
#define MAX_LOD_LEVELS           4
#define MAX_GPU_OBJECTS          65536
#define MAX_HIZ_MIPS             13
#define GPU_CULL_BUCKET_COUNT    6

// Meshlet culling (keep in sync with ve_config.hpp)
#define MAX_MESHLET_DRAWS           1048576
#define MESHLET_CULL_WORKGROUP_SIZE 256
#define MESHLET_MAX_VERTICES        64
#define MESHLET_MAX_TRIANGLES       124
#define MESHLET_BUCKET_COUNT        6
#define MESHLET_SHADOW_BUCKET_COUNT 4
#define MAX_MESHLET_SHADOW_DRAWS    1048576

// LOD screen-space thresholds (keep in sync with LOD_SCREEN_THRESHOLDS in ve_config.hpp)
static const float LOD_SCREEN_THRESHOLDS[3] = { 0.70, 0.35, 0.15 };

enum ShadowMode {
	DISABLED = 0,
	REGULAR = 1,
	PCF = 2,
	PCSS = 3,
};

// Material flags (bits 0-5, in material_flags field)
#define MAT_FLAG_ALPHA_MODE_MASK   0x3u
#define MAT_FLAG_DOUBLE_SIDED      0x4u
#define MAT_FLAG_FLIP_TEX_V        0x8u
#define MAT_FLAG_SPEC_GLOSS        0x10u
#define MAT_FLAG_HAS_TEXTURE       0x20u

// Object flags (in object_flags field)
#define OBJ_FLAG_IS_TRANSPARENT    0x1u
#define OBJ_FLAG_NO_SHADOW         0x2u
#define OBJ_FLAG_DYNAMIC           0x4u
#define OBJ_FLAG_SKINNED           0x8u

[vk::constant_id(0)] const uint SHADOW_MODE_SPEC = 0;
[vk::constant_id(1)] const uint PCF_SAMPLES_SPEC = 8; // PCF + PCSS blocker: 4, 8, 16, or 32
[vk::constant_id(2)] const uint PCSS_FILTER_SAMPLES_SPEC = 16; // PCSS filter: 8, 16, or 32
[vk::constant_id(3)] const uint SHADOW_MASK_SPEC = 0; // 0=inline CSM, 1=sample mask

#endif
