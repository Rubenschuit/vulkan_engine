#ifndef CULL_COMMON_SLANGH
#define CULL_COMMON_SLANGH

// Shared data structures and helper functions for GPU culling passes.
// Include ve_constants.slangh before this header.

// ---------------------------------------------------------------------------
// Shared structs
// ---------------------------------------------------------------------------

struct ObjectDataGPU {
	float4 bounding_sphere;             // local-space center (xyz), radius (w)
	uint   vertex_offset;
	uint   material_index;
	uint   material_flags;
	uint   object_flags;
	uint   lod_count;
	uint   lod_draw_group_id[MAX_LOD_LEVELS];
	uint   lod_index_count[MAX_LOD_LEVELS];
	uint   _pad[3];
};

struct TransformGPU {
	float4x4 world_transform;
	float4   normal_col0;
	float4   normal_col1;
	float4   normal_col2;
};

struct DrawGroupGPU {
	uint instance_base;
	uint max_instances;
};

struct InstanceData {
	float4x4 transform;
	float4   normal_col0;
	float4   normal_col1;
	float4   normal_col2;
	uint     material_index;
	uint     lod_level;
	float    depth_offset;
	uint     material_flags;
};

struct ActiveIdEntry {
	uint gpu_id;
	uint _pad;
};

struct CullParams {
	float4   frustum_planes[6];  // xyz = normal, w = distance
	float4x4 view_proj;
	float4x4 view;
	float4x4 prev_view;         // previous frame's view matrix for Hi-Z reprojection
	float    p00;                // projection[0][0] (horizontal focal length)
	float    p11;                // projection[1][1] (vertical focal length)
	float    p22;                // projection[2][2] (depth mapping)
	float    p32;                // projection[3][2] (depth offset)
	uint     object_count;
	uint     hiz_enabled;        // 0 = frustum only, 1 = frustum + prev-frame Hi-Z
	uint     is_shadow_pass;
	uint     hiz_mip_count;
	float2   hiz_size;           // mip 0 resolution
	int      lod_bias;           // 0 for main pass, cascade_index for shadow passes
	uint     max_meshlet_draws;  // MAX_MESHLET_DRAWS for main, MAX_MESHLET_SHADOW_DRAWS for shadow
	float4   camera_pos;         // xyz = world-space camera position (for cone culling)
	uint     bucket_count;       // MESHLET_BUCKET_COUNT (6); used by meshlet pass-2 for per-bucket capacity
	uint     shadow_cone_cull;   // 1 = enable backface cone culling in shadow pass (directional lights)
};

// Per-meshlet GPU metadata (64 bytes, matches MeshletGPU in C++)
struct MeshletGPU {
	float4 bounding_sphere;  // local-space center (xyz), radius (w)
	float4 cone_apex;        // local-space cone apex (xyz), unused (w)
	float4 cone_axis_cutoff; // local-space cone axis (xyz), cos(half-angle) cutoff (w)
	uint   index_offset;     // first index in global meshlet IBO
	uint   index_count;      // triangle_count * 3
	uint   vertex_offset;    // start vertex in mega VBO
	uint   _pad;
};

// Per-object meshlet table indexed by gpu_id (32 bytes)
struct MeshletObjectInfo {
	uint meshlet_offset[MAX_LOD_LEVELS];
	uint meshlet_count[MAX_LOD_LEVELS];
};

// Pass-1 output: one entry per visible object (16 bytes)
struct VisibleObjectEntry {
	uint gpu_id;
	uint lod_level;
	uint meshlet_offset;  // cached from MeshletObjectInfo[gpu_id][lod]
	uint meshlet_count;
};

// ---------------------------------------------------------------------------
// Helper functions
// ---------------------------------------------------------------------------

float extractMaxScale(float4x4 m) {
	float sx = length(float3(m[0][0], m[1][0], m[2][0]));
	float sy = length(float3(m[0][1], m[1][1], m[2][1]));
	float sz = length(float3(m[0][2], m[1][2], m[2][2]));
	return max(max(sx, sy), sz);
}

bool frustumTest(CullParams params, float3 center, float radius) {
	for (int p = 0; p < 6; p++) {
		float dist = dot(params.frustum_planes[p].xyz, center) + params.frustum_planes[p].w;
		if (dist < -radius)
			return false;
	}
	return true;
}

// Projects a world-space bounding sphere into the previous frame's screen space
// and samples the Hi-Z pyramid (which was built from the previous frame's depth).
// Returns true if the sphere might be visible (should NOT be culled).
bool hizOcclusionTest(CullParams params, Texture2D<float> hiz_tex, SamplerState hiz_smp,
                      float3 center_world, float radius) {
	// Current-frame near-plane check
	float3 center_view = mul(params.view, float4(center_world, 1.0)).xyz;
	float cz = -center_view.z;
	if (cz <= radius)
		return true;

	float3 prev_view_pos = mul(params.prev_view, float4(center_world, 1.0)).xyz;
	float prev_cx = prev_view_pos.x;
	float prev_cy = prev_view_pos.y;
	float prev_cz = -prev_view_pos.z;
	if (prev_cz <= radius)
		return true;

	float r2       = radius * radius;
	float prev_cz2 = prev_cz * prev_cz;
	float denom    = prev_cz2 - r2;

	float t_xz = sqrt(prev_cx * prev_cx + prev_cz2 - r2);
	float x1 = params.p00 * (prev_cx * prev_cz + radius * t_xz) / denom;
	float x2 = params.p00 * (prev_cx * prev_cz - radius * t_xz) / denom;

	float t_yz = sqrt(prev_cy * prev_cy + prev_cz2 - r2);
	float y1 = params.p11 * (prev_cy * prev_cz + radius * t_yz) / denom;
	float y2 = params.p11 * (prev_cy * prev_cz - radius * t_yz) / denom;

	float2 uv_min = float2(min(x1, x2), min(y1, y2)) * 0.5 + 0.5;
	float2 uv_max = float2(max(x1, x2), max(y1, y2)) * 0.5 + 0.5;

	// Skip Hi-Z when the sphere projected outside the previous frame's screen.
	if (uv_min.x < 0.0 || uv_min.y < 0.0 || uv_max.x > 1.0 || uv_max.y > 1.0)
		return true;

	float2 aabb_pixels = (uv_max - uv_min) * params.hiz_size;
	float max_dim = max(aabb_pixels.x, aabb_pixels.y);
	if (max_dim <= 0.0)
		return true;

	float mip = floor(log2(max_dim));
	mip = clamp(mip, 0.0, float(params.hiz_mip_count - 1));

	float2 uv_center = (uv_min + uv_max) * 0.5;
	float hiz_depth = hiz_tex.SampleLevel(hiz_smp, uv_center, int(mip));
	float d00 = hiz_tex.SampleLevel(hiz_smp, uv_min, int(mip));
	float d11 = hiz_tex.SampleLevel(hiz_smp, uv_max, int(mip));
	float d01 = hiz_tex.SampleLevel(hiz_smp, float2(uv_min.x, uv_max.y), int(mip));
	float d10 = hiz_tex.SampleLevel(hiz_smp, float2(uv_max.x, uv_min.y), int(mip));
	hiz_depth = min(min(d00, d11), min(min(d01, d10), hiz_depth));

	float z_nearest = prev_view_pos.z + radius;
	float nearest_ndc_z = (params.p22 * z_nearest + params.p32) / (-z_nearest);

	return nearest_ndc_z >= hiz_depth;
}

// Select LOD level based on projected screen-space size.
uint selectLod(CullParams params, float3 center_world, float radius, uint lod_count) {
	uint lod;
	if (params.is_shadow_pass != 0) {
		lod = 0;
	} else {
		float3 center_view = mul(params.view, float4(center_world, 1.0)).xyz;
		float depth = max(-center_view.z, 0.001);
		float screen_frac = (radius * abs(params.p11)) / depth;

		if      (screen_frac >= LOD_SCREEN_THRESHOLDS[0]) lod = 0;
		else if (screen_frac >= LOD_SCREEN_THRESHOLDS[1]) lod = 1;
		else if (screen_frac >= LOD_SCREEN_THRESHOLDS[2]) lod = 2;
		else                                               lod = 3;
	}
	int biased = int(lod) + params.lod_bias;
	return uint(clamp(biased, 0, int(lod_count) - 1));
}

#endif // CULL_COMMON_SLANGH
