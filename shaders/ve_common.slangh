#ifndef VE_COMMON_SLANGH
#define VE_COMMON_SLANGH

// Shared definitions, UBO, bindings, and shadow functions for PBR and simple shaders.
// Each shader only needs to declare its own material textures (set 1) and push constants.

#define PI 3.1415926536
#include "ve_constants.slangh"

// Relative start of both roughness fades: SSR fades out over
// [SPEC_HANDOFF_FADE_START * m, m] with m = push.max_roughness, RC rough
// specular fades in over [SPEC_HANDOFF_FADE_START * s, s] with
// s = RC_SPEC_HANDOFF_ROUGHNESS. The two ends are independent; where they
// overlap the composite arbitrates by SSR confidence.
static const float SPEC_HANDOFF_FADE_START = 0.85;
// Roughness at which RC rough specular fully replaces the environment.
static const float RC_SPEC_HANDOFF_ROUGHNESS = 0.3;

// ============================================================================
// Light structs (keep in sync with ve_frame_info.hpp)
// ============================================================================

struct PointLight {
	float4 position;
	float4 color; // .w = intensity
};

struct DirectionalLight {
	float4 direction;  // xyz = direction toward surface, w = unused
	float4 color;      // xyz = color * intensity, w = intensity
};

struct SpotLight {
	float4 position;    // xyz = world pos, w = range
	float4 direction;   // xyz = normalized dir, w = cos(outerConeAngle)
	float4 color;       // xyz = color*intensity, w = cos(innerConeAngle)
};

struct RectLight {
	float4 center;     // xyz = world center, w = influence radius
	float4 color;      // xyz = color*intensity, w = two-sided flag
	float4 right_half; // xyz = world right axis * half-width
	float4 up_half;    // xyz = world up axis * half-height
};

struct ShadowLight {
	float4x4 light_view;
	float4x4 light_proj;
	float4x4 shadow_matrix;
	float4 light_index_padding; // x = light_index, y = type (0=point, 1=directional, 2=spot), zw = padding
	float4 atlas_bounds;        // xy = min UV, zw = max UV (atlas region for XY bounds check)
};

// Keep in sync with RenderMode enum in ve_frame_info.hpp
enum RenderMode {
	BRDF = 0,
	NORMAL_VECTOR = 1,
	TANGENT_VECTOR = 2,
	BITANGENT_VECTOR = 3,
	NORMAL_MAP = 4,
	BRDF_MICROFACET = 5,
	CSM_CASCADE = 6,
	CLUSTER_HEATMAP = 7,
	LOD_LEVEL = 8,
	MESHLET_ID = 9,
	RC_IRRADIANCE = 10,
	RC_SKY_VISIBILITY = 11,
	RC_UPSAMPLE_MATCH = 12,
};

// ============================================================================
// Uniform buffer + global bindings (set 0)
// ============================================================================

struct UniformBuffer {
	float4x4 view;
	float4x4 proj;
	float4x4 projection_view;
	float4 camera_position; // .w unused
	float4 ambient_light_color;
	ShadowLight shadow_lights[MAX_SHADOW_LIGHTS];
	uint32_t num_shadow_lights;
	uint32_t render_mode; // see RenderMode enum
	uint32_t shadow_mode;
	float shadow_bias;
	uint32_t num_dir_lights;
	float _pad_dir_0;
	float _pad_dir_1;
	DirectionalLight dir_lights[MAX_DIR_LIGHTS];

	// CSM (Cascaded Shadow Maps)
	float4x4 csm_shadow_matrices[NUM_CSM_CASCADES];
	float4   csm_split_distances;  // view-space far-Z per cascade
	uint32_t csm_cascade_count;
	uint32_t csm_base_layer;
	uint32_t csm_dir_light_index;
	float    pcss_light_size;
	uint32_t csm_blend_dithered;
	float    csm_normal_bias;
	float4   csm_world_texel_size;
	float4   csm_atlas_rect[NUM_CSM_CASCADES]; // xy = min UV, zw = max UV
	float4   csm_depth_range;                  // light-space depth range per cascade, world units
	float2   shadow_texel_size;                // 1 / shadow atlas size
	float    csm_tan_angular_radius;
	float    _pad_csm_0;

	// Screen-space shadow mask
	float4x4 inverse_projection_view;
	float4x4 prev_projection_view;
	float2   screen_size;
	float    _pad_screen_0;
	float    _pad_screen_1;

	// Spot lights
	uint32_t num_spot_lights;
	float    _pad_spot_0;
	float    _pad_spot_1;
	float    _pad_spot_2;
	SpotLight spot_lights[MAX_SPOT_LIGHTS];

	// IBL parameters
	uint32_t ibl_active;
	uint32_t prefiltered_mip_levels;
	float    ibl_min_ambient;
	float    _pad_ibl_0;
	float4   sh_coefficients[9];

	// LTC rectangular area lights
	RectLight rect_lights[MAX_RECT_LIGHTS];
	uint32_t num_rect_lights;
	float    _pad_rect_0;
	float    _pad_rect_1;
	float    _pad_rect_2;

	// RC GI parameters
	float4   sky_radiance_scale;
	uint     num_point_lights;
};
[vk::binding(0, 0)]
ConstantBuffer<UniformBuffer> ubo;

// Per-instance transforms stored in SSBO, indexed by SV_VulkanInstanceID (= gl_InstanceIndex = firstInstance + i)
struct InstanceData {
	float4x4 transform;
	float4   normal_col0;
	float4   normal_col1;
	float4   normal_col2;
	uint     material_index;
	uint     lod_level;
	float    depth_offset;
	uint     material_flags;
};
[vk::binding(1, 0)]
StructuredBuffer<InstanceData> instances;

struct MaterialGPU {
	float4 base_color_factor;
	float4 emissive_factor;
	float4 pbr_params;            // metallic, roughness, emissive_strength, transmission
	float4 specular_color_ior;    // specularColorFactor.xyz, ior
	uint   albedo_index;
	uint   normal_index;
	uint   metallic_roughness_index;
	uint   occlusion_index;
	uint   emissive_index;
	uint   material_flags;
	float  alpha_cutoff;
	uint   specular_index;
	uint   specular_color_index;
	float  specular_strength;
	float  occlusion_strength;
	uint   _pad1;
	// KHR_texture_transform, per slot: (offset.xy, scale.xy). Identity when unused.
	float4 uv_albedo;
	float4 uv_metal_rough;
	float4 uv_normal;
	float4 uv_occlusion;
	float4 uv_emissive;
	float4 uv_rot_a;  // rotation radians: x=albedo y=metalRough z=normal w=occlusion
	float4 uv_rot_b;  // x=emissive, yzw reserved
};
[vk::binding(2, 0)]
StructuredBuffer<MaterialGPU> materials;

#ifndef VE_COMMON_NO_SCENE_SETS

// ============================================================================
// Shadow map bindings (set 2)
// ============================================================================

[vk::binding(0, 2)]
SamplerComparisonState shadow_cmp_sampler;
[vk::binding(1, 2)]
Texture2D shadow_atlas;
[vk::binding(2, 2)]
SamplerState shadow_sampler;  // Raw depth reads

// ============================================================================
// Screen-space shadow mask bindings (set 3)
// ============================================================================

[vk::binding(0, 3)]
Texture2D<float2> shadow_mask;   // .x = CSM visibility, .y = view-space depth (for bilateral upsample)
[vk::binding(1, 3)]
SamplerState shadow_mask_sampler;

// ============================================================================
// Clustered lighting bindings (set 4)
// ============================================================================

#include "ve_cluster.slangh"

[[vk::binding(0, 4)]]
StructuredBuffer<PointLight> cluster_lights;
[[vk::binding(1, 4)]]
StructuredBuffer<uint2> cluster_light_counts;  // (offset, count) per cluster
[[vk::binding(2, 4)]]
StructuredBuffer<uint> cluster_light_indices;
[[vk::binding(3, 4)]]
ConstantBuffer<ClusterParams> cluster_params;

// ============================================================================
// GTAO ambient occlusion + RC GI bindings (set 5)
// ============================================================================

[vk::binding(0, 5)]
Texture2D<float> ao_texture;
[vk::binding(1, 5)]
SamplerState ao_sampler;

[vk::binding(2, 5)]
Texture2D<float4> rc_texture;
[vk::binding(3, 5)]
SamplerState rc_sampler;

[vk::binding(4, 5)]
Texture2D<float> rc_sky_visibility;

[vk::binding(5, 5)]
Texture2D<float4> rc_spec_texture;

[vk::binding(6, 5)]
Texture2D<float4> rc_geometry_texture;

// ============================================================================
// IBL bindings (set 6)
// ============================================================================

[vk::binding(0, 6)]
SamplerCube ibl_prefiltered;
[vk::binding(1, 6)]
Sampler2D<float2> ibl_brdf_lut;

// LTC area-light lookup tables
[vk::binding(2, 6)]
Sampler2D<float4> ltc_mat;   // inverse-transform matrix terms
[vk::binding(3, 6)]
Sampler2D<float4> ltc_mag;   // BRDF magnitude + Fresnel terms

// ============================================================================
// SSR bindings (set 7)
// ============================================================================

[vk::binding(0, 7)]
Texture2D<float4> ssr_texture;   // rgb premultiplied by a, the confidence
[vk::binding(1, 7)]
SamplerState ssr_sampler;

#endif // VE_COMMON_NO_SCENE_SETS

// ============================================================================
// Utilities
// ============================================================================

// KHR_texture_transform: uv' = (Translate * Rotate * Scale) * uv.
// identity (offset 0, scale 1, rot 0) is a no-op.
float2 applyUvTransform(float2 uv, float4 off_scale, float rot) {
	float2 t = uv * off_scale.zw;
	if (rot == 0.0)
		return t + off_scale.xy;
	float s = sin(rot), c = cos(rot);
	return float2(c * t.x - s * t.y, s * t.x + c * t.y) + off_scale.xy;
}

// Surface math shared by the geometry prepass and forward shading.

// World-space TBN from the instance normal matrix (tangent w = handedness)
void makeWorldTbn(InstanceData inst, float3 in_normal, float4 in_tangent,
                  out float3 normal, out float3 tangent, out float3 bitangent) {
	float3x3 normal_matrix = float3x3(
		float3(inst.normal_col0.x, inst.normal_col1.x, inst.normal_col2.x),
		float3(inst.normal_col0.y, inst.normal_col1.y, inst.normal_col2.y),
		float3(inst.normal_col0.z, inst.normal_col1.z, inst.normal_col2.z)
	);
	tangent = mul(normal_matrix, in_tangent.xyz);
	normal = normalize(mul(normal_matrix, in_normal));
	bitangent = normalize(cross(normal, tangent) * in_tangent.w);
}

// Tangent-space normal mapping
float3 applyNormalMap(float3 normal_map_rgb, float3 T, float3 B, float3 N) {
	float3 tsn = normalize(normal_map_rgb * 2.0 - float3(1.0, 1.0, 1.0));
	return normalize(tsn.x * T + tsn.y * B + tsn.z * N);
}

// Flip toward the camera by view vector, after normal mapping.
float3 flipDoubleSided(float3 normal, float3 view_dir, uint material_flags) {
	if ((material_flags & MAT_FLAG_DOUBLE_SIDED) != 0u && dot(normal, view_dir) < 0.0)
		return -normal;
	return normal;
}

bool alphaMaskCutoff(MaterialGPU mat, float tex_alpha, float vertex_alpha) {
	return tex_alpha * mat.base_color_factor.a * vertex_alpha < mat.alpha_cutoff;
}

float spatialNoise(uint2 coord) {
	return frac(52.9829189 * frac(dot(float2(coord), float2(0.06711056, 0.00583715))));
}

float3 fresnelSchlickRoughness(float cos_theta, float3 F0, float roughness) {
	float t = clamp(1.0 - cos_theta, 0.0, 1.0);
	float t2 = t * t;
	return F0 + (max(float3(1.0 - roughness), F0) - F0) * (t2 * t2 * t);
}

// Evaluate L2 spherical harmonics irradiance from 9 pre-scaled coefficients (cmgen format)
float3 evaluateSH(float3 n, float4 sh[9]) {
	return max(sh[0].xyz
		+ sh[1].xyz * n.y + sh[2].xyz * n.z + sh[3].xyz * n.x
		+ sh[4].xyz * (n.y * n.x) + sh[5].xyz * (n.y * n.z)
		+ sh[6].xyz * (3.0 * n.z * n.z - 1.0)
		+ sh[7].xyz * (n.z * n.x)
		+ sh[8].xyz * (n.x * n.x - n.y * n.y), 0.0);
}

// Specular occlusion from diffuse AO
// Rough surfaces lose reflections faster in occluded areas; smooth surfaces retain them.
float specularAO(float NdotV, float ao, float roughness) {
	return clamp(pow(NdotV + ao, exp2(-16.0 * roughness - 1.0)) - 1.0 + ao, 0.0, 1.0);
}

// A light whose peak incident radiance times n.l falls below this is skipped:
// by the raster light loop, and by RC hit shading before its shadow ray
static const float LIGHT_RADIANCE_CUTOFF = 1e-3;

// KHR_lights_punctual attenuation: smooth windowed falloff within range, 1/d² when range=0
float calculateAttenuation(float distance_sq, float range) {
	if (range > 0.0) {
		float range_sq = range * range;
		float ratio2 = distance_sq / range_sq;
		float ratio4 = ratio2 * ratio2;
		float window = clamp(1.0 - ratio4, 0.0, 1.0);
		return (window * window) / max(distance_sq, 0.0001);
	}
	return 1.0 / max(distance_sq, 0.0001);
}

// Spot light angular attenuation: smooth falloff between inner and outer cone (glTF spec)
// frag_to_light_n must be pre-normalized
float calculateSpotAttenuation(float3 frag_to_light_n, float3 spot_direction,
                                float cos_outer, float cos_inner) {
	float cos_angle = dot(-frag_to_light_n, spot_direction);
	if (cos_angle < cos_outer)
		return 0.0;
	if (cos_angle > cos_inner)
		return 1.0;
	float t = (cos_angle - cos_outer) / (cos_inner - cos_outer);
	return t * t;  // quadratic falloff
}

// ============================================================================
// Shadow sampling functions
// ============================================================================

#ifndef VE_COMMON_NO_SCENE_SETS

// Hardware comparison shadow test: returns 1.0 (lit) or 0.0 (shadow) with free 2x2 bilinear PCF
float calculateShadowTerm(float4 shadow_coord, float2 offset) {
	if (shadow_coord.z <= -1.0 || shadow_coord.z >= 1.0 || shadow_coord.w <= 0.0)
		return 1.0;
	return shadow_atlas.SampleCmpLevelZero(shadow_cmp_sampler,
		shadow_coord.xy + offset, shadow_coord.z - ubo.shadow_bias);
}

// 8-sample Poisson disk
static const float2 POISSON_DISK_8[8] = {
	float2(-0.7071,  0.7071), float2( 0.0000, -0.8750),
	float2( 0.8660,  0.5000), float2(-0.6614, -0.3536),
	float2( 0.3090,  0.9511), float2( 0.5878, -0.8090),
	float2(-0.9511,  0.0000), float2( 0.2588, -0.1830),
};

// 16-sample Poisson disk
static const float2 POISSON_DISK_16[16] = {
	float2(-0.9420, -0.3990), float2( 0.9456, -0.7689),
	float2(-0.0942, -0.9293), float2( 0.3449,  0.2939),
	float2(-0.9159,  0.4579), float2(-0.8154, -0.8790),
	float2(-0.3826,  0.2762), float2( 0.9748,  0.7563),
	float2( 0.4437, -0.0865), float2( 0.1628,  0.8842),
	float2(-0.5466, -0.0710), float2(-0.1877,  0.7574),
	float2( 0.7063,  0.3567), float2(-0.4483, -0.5765),
	float2( 0.5765, -0.5011), float2(-0.0310, -0.3949),
};

// 32-sample Poisson disk
static const float2 POISSON_DISK_32[32] = {
	float2(-0.2138,  0.8933), float2( 0.1815, -0.9890),
	float2( 0.8765,  0.2841), float2(-0.9613, -0.1357),
	float2( 0.4058, -0.5805), float2(-0.5832,  0.5476),
	float2( 0.7485, -0.4187), float2(-0.3495, -0.7276),
	float2(-0.0684,  0.3795), float2( 0.6253,  0.7416),
	float2(-0.7869, -0.5137), float2( 0.2440,  0.4335),
	float2( 0.9167, -0.0795), float2(-0.4563,  0.1226),
	float2(-0.1368, -0.3875), float2( 0.4753,  0.0854),
	float2(-0.8537,  0.3460), float2( 0.0923, -0.6328),
	float2( 0.3213,  0.9249), float2(-0.6424, -0.2156),
	float2( 0.7891,  0.5632), float2(-0.2715, -0.9418),
	float2(-0.9182,  0.0728), float2( 0.5510, -0.8136),
	float2( 0.0267,  0.6940), float2(-0.5186,  0.8175),
	float2( 0.6831, -0.1743), float2(-0.3928, -0.4582),
	float2( 0.1648,  0.1391), float2(-0.7326,  0.6574),
	float2( 0.9514, -0.2870), float2(-0.0533, -0.1486),
};

// Select Poisson disk sample by count (compile-time; dead branches eliminated by spec constants)
float2 pcfDiskSample(uint i) {
	if (PCF_SAMPLES_SPEC <= 8)  return POISSON_DISK_8[i];
	if (PCF_SAMPLES_SPEC <= 16) return POISSON_DISK_16[i];
	return POISSON_DISK_32[i];
}
float2 pcssFilterDiskSample(uint i) {
	if (PCSS_FILTER_SAMPLES_SPEC <= 16) return POISSON_DISK_16[i];
	return POISSON_DISK_32[i];
}

static const float PCSS_MAX_SPREAD_TEXELS = 25.0;

// Interleaved gradient noise (Jimenez 2014) in [0,1)
float interleavedGradientNoise(float2 pixel) {
	return frac(52.9829189 * frac(dot(floor(pixel), float2(0.06711056, 0.00583715))));
}

// Per-pixel Poisson disk rotation
float2 shadowDiskRotation(float2 pixel) {
	float angle = interleavedGradientNoise(pixel) * 2.0 * PI;
	return float2(sin(angle), cos(angle));
}

// Rotated disk sample scaled to radius_texels, in atlas UV
float2 shadowDiskOffset(float2 disk, float2 rot, float radius_texels) {
	return float2(rot.y * disk.x - rot.x * disk.y, rot.x * disk.x + rot.y * disk.y)
		* radius_texels * ubo.shadow_texel_size;
}

// Bilinear taps per axis of the PCF tent
uint pcfTentTapsPerAxis() {
	if (PCF_SAMPLES_SPEC <= 4)  return 2;
	if (PCF_SAMPLES_SPEC <= 8)  return 3;
	if (PCF_SAMPLES_SPEC <= 16) return 4;
	return 5;
}

// Tap k of the 1D tent over texels (2k - taps + 1) and the next one, relative to the texel at or
// below the lookup; f = sub-texel position. Returns (summed weight, tap position between the two)
float2 pcfTentTap(uint k, uint taps, float f) {
	float half_width = float(taps) - 0.5;
	float i0 = float(2 * k) - float(taps - 1);
	float w0 = max(0.0, half_width - abs(i0 - f));
	float w1 = max(0.0, half_width - abs(i0 + 1.0 - f));
	return float2(w0 + w1, i0 + w1 / (w0 + w1));
}

// Tent-filtered PCF (Castano, "Shadow Mapping Summary")
float calculateShadowPCF(float4 shadow_coord) {
	if (shadow_coord.z <= -1.0 || shadow_coord.z >= 1.0 || shadow_coord.w <= 0.0)
		return 1.0;

	uint taps = pcfTentTapsPerAxis();
	float2 texel = shadow_coord.xy / ubo.shadow_texel_size - 0.5;
	float2 base = floor(texel);
	float2 f = texel - base;
	float ref_depth = shadow_coord.z - ubo.shadow_bias;

	float shadow = 0.0;
	float weight_sum = 0.0;
	for (uint ty = 0; ty < taps; ty++) {
		float2 tap_y = pcfTentTap(ty, taps, f.y);
		for (uint tx = 0; tx < taps; tx++) {
			float2 tap_x = pcfTentTap(tx, taps, f.x);
			float2 uv = (base + float2(tap_x.y, tap_y.y) + 0.5) * ubo.shadow_texel_size;
			float w = tap_x.x * tap_y.x;
			shadow += w * shadow_atlas.SampleCmpLevelZero(shadow_cmp_sampler, uv, ref_depth);
			weight_sum += w;
		}
	}
	return shadow / weight_sum;
}

// Average depth of the blockers in a rotated Poisson disk; false when there are none.
// Each tap gathers its 2x2 texel quad: the disk spans up to 25 texels, and with single
// texels a few taps miss small occluders often enough to leave lit pixels in the umbra.
bool pcssBlockerSearch(float2 uv, float receiver, float radius_texels, float2 rot, out float avg_blocker) {
	float blocker_sum = 0.0;
	float blocker_count = 0.0;
	for (uint i = 0; i < PCF_SAMPLES_SPEC; i++) {
		float2 offset = shadowDiskOffset(pcfDiskSample(i), rot, radius_texels);
		float4 depths = shadow_atlas.GatherRed(shadow_sampler, uv + offset);
		float4 is_blocker = step(depths + ubo.shadow_bias, float4(receiver));
		blocker_sum += dot(is_blocker, depths);
		blocker_count += dot(is_blocker, float4(1.0));
	}
	avg_blocker = blocker_count > 0.0 ? blocker_sum / blocker_count : 0.0;
	return blocker_count > 0.0;
}

float pcssFilter(float2 uv, float ref_depth, float spread_texels, float2 rot) {
	float shadow = 0.0;
	for (uint i = 0; i < PCSS_FILTER_SAMPLES_SPEC; i++)
		shadow += shadow_atlas.SampleCmpLevelZero(shadow_cmp_sampler,
			uv + shadowDiskOffset(pcssFilterDiskSample(i), rot, spread_texels), ref_depth);
	return shadow / float(PCSS_FILTER_SAMPLES_SPEC);
}

float calculatePCSS(float4 shadow_coord, float2 rot) {
	if (shadow_coord.z <= -1.0 || shadow_coord.z >= 1.0 || shadow_coord.w <= 0.0)
		return 1.0;

	float receiver = shadow_coord.z;
	float light_size = ubo.pcss_light_size;

	// A search that finds nothing can still have missed an occluder: fall back to a hard test
	float avg_blocker;
	if (!pcssBlockerSearch(shadow_coord.xy, receiver, light_size * 600.0, rot, avg_blocker))
		return calculateShadowTerm(shadow_coord, float2(0.0, 0.0));

	// light_size scales the penumbra in atlas UV; measured in horizontal texels
	float penumbra_texels = (receiver - avg_blocker) / avg_blocker * light_size / ubo.shadow_texel_size.x;
	float spread_texels = clamp(penumbra_texels, 1.0, PCSS_MAX_SPREAD_TEXELS);
	return pcssFilter(shadow_coord.xy, receiver - ubo.shadow_bias, spread_texels, rot);
}

// Orthographic cascade: NDC depth is linear in light-space distance, so the penumbra radius is the
// receiver-to-blocker distance in world units times the tangent of the light's angular radius.
// min_spread_texels raises the floor so contact shadows match the next cascade in the blend band.
float calculateCascadePCSS(uint cascade, float4 shadow_coord, float2 rot, float min_spread_texels) {
	if (shadow_coord.z <= 0.0 || shadow_coord.z >= 1.0)
		return 1.0;

	float receiver = shadow_coord.z;
	float avg_blocker;
	if (!pcssBlockerSearch(shadow_coord.xy, receiver, PCSS_MAX_SPREAD_TEXELS, rot, avg_blocker))
		return calculateShadowTerm(shadow_coord, float2(0.0, 0.0));

	float penumbra_texels = (receiver - avg_blocker) * ubo.csm_depth_range[cascade]
		* ubo.csm_tan_angular_radius / ubo.csm_world_texel_size[cascade];
	float spread_texels = clamp(penumbra_texels, min(min_spread_texels, PCSS_MAX_SPREAD_TEXELS), PCSS_MAX_SPREAD_TEXELS);
	return pcssFilter(shadow_coord.xy, receiver - ubo.shadow_bias, spread_texels, rot);
}

// pcss_min_spread: PCSS penumbra floor in this cascade's texels
float sampleCascadeShadow(uint cascade, float3 shadow_coord, float2 rot, float pcss_min_spread) {
	float4 sc = float4(shadow_coord, 1.0);
	if (SHADOW_MODE_SPEC == ShadowMode::PCSS)
		return calculateCascadePCSS(cascade, sc, rot, pcss_min_spread);
	else if (SHADOW_MODE_SPEC == ShadowMode::PCF)
		return calculateShadowPCF(sc);
	else
		return calculateShadowTerm(sc, float2(0.0, 0.0));
}

float3 cascadeShadowCoord(uint cascade, float3 frag_pos_world, float3 normal_offset_texels) {
	float3 biased_pos = frag_pos_world + normal_offset_texels * ubo.csm_world_texel_size[cascade];
	float4 sc = mul(ubo.csm_shadow_matrices[cascade], float4(biased_pos, 1.0));
	return sc.xyz / sc.w;
}

float cascadeResolution(uint cascade) {
	return (ubo.csm_atlas_rect[cascade].z - ubo.csm_atlas_rect[cascade].x) / ubo.shadow_texel_size.x;
}

// Texels from a shadow coord to the nearest edge of the cascade's atlas region, negative outside
float cascadeEdgeTexels(uint cascade, float3 shadow_coord) {
	float4 rect = ubo.csm_atlas_rect[cascade];
	float2 edge = min(shadow_coord.xy - rect.xy, rect.zw - shadow_coord.xy) / (rect.zw - rect.xy);
	return min(edge.x, edge.y) * cascadeResolution(cascade);
}

// Texels the shadow filter reads beyond the lookup position
float cascadeFilterReach() {
	if (SHADOW_MODE_SPEC == ShadowMode::PCSS)
		return PCSS_MAX_SPREAD_TEXELS + 1.0;
	if (SHADOW_MODE_SPEC == ShadowMode::PCF)
		return float(pcfTentTapsPerAxis()) + 0.5;
	return 1.0;
}

// The next cascade's texel size in this cascade's texels
float cascadeNextTexelRatio(uint cascade) {
	return ubo.csm_world_texel_size[cascade + 1] / ubo.csm_world_texel_size[cascade];
}

// pixel: screen (or shadow mask) pixel, seeds the filter rotation and the dither
float calculateCSMShadow(float3 frag_pos_world, float frag_view_z, float3 geo_normal, float2 pixel,
                          out uint out_cascade, out float out_blend) {
	out_cascade = 0;
	out_blend = 0.0;
	if (ubo.csm_cascade_count == 0)
		return 1.0;
	uint last = ubo.csm_cascade_count - 1;
	float max_distance = ubo.csm_split_distances[last];
	if (frag_view_z > max_distance)
		return 1.0;

	// Normal-offset bias: push the sample along the surface normal by csm_normal_bias shadow
	// texels of the sampled cascade (in world space)
	float slope_scale = 1.0;
	if (ubo.csm_dir_light_index != 0xFFFFFFFF) {
		float3 light_dir = normalize(-ubo.dir_lights[ubo.csm_dir_light_index].direction.xyz);
		float ndotl = saturate(dot(geo_normal, light_dir));
		slope_scale = sqrt(max(0.0, 1.0 - ndotl * ndotl));
	}
	float3 normal_offset_texels = geo_normal * ubo.csm_normal_bias * slope_scale;

	// csm_blend_dithered: 0=off, 1=linear, 2=dithered
	bool blend = ubo.csm_blend_dithered != 0;

	// A cascade also hands off once one screen pixel spans more than this many of its texels:
	// depth maps can't be prefiltered, so a map denser than the pixel aliases into moire bands,
	// and its texel-sized bias no longer covers the pixel
	const float MAX_TEXELS_PER_PIXEL = 2.0;
	float pixel_world = frag_view_z * 2.0 / (abs(ubo.proj[1][1]) * ubo.screen_size.y);

	// Map-based selection: the first cascade whose atlas region holds the whole filter footprint.
	// The fit spheres nest, so each map also covers fragments well past its view-depth split.
	uint cascade = last;
	float3 sc = float3(0.0);
	float edge = 0.0;
	float texels_per_pixel = 0.0;
	for (uint i = 0; i <= last; i++) {
		sc = cascadeShadowCoord(i, frag_pos_world, normal_offset_texels);
		if (i == last)
			break;
		edge = cascadeEdgeTexels(i, sc) - cascadeFilterReach();
		texels_per_pixel = pixel_world / ubo.csm_world_texel_size[i];
		if (edge > 0.0 && sc.z > 0.0 && sc.z < 1.0 && texels_per_pixel < MAX_TEXELS_PER_PIXEL) {
			cascade = i;
			break;
		}
	}

	// Blend band: the outer BLEND_FRACTION of the region's half-width inside the margin, or of the
	// texel density range below MAX_TEXELS_PER_PIXEL
	const float BLEND_FRACTION = 0.15;
	float t = 0.0;
	float3 next_sc = sc;
	if (blend && cascade < last) {
		float t_edge = saturate(1.0 - edge / (BLEND_FRACTION * 0.5 * cascadeResolution(cascade)));
		float t_density = saturate((texels_per_pixel / MAX_TEXELS_PER_PIXEL - (1.0 - BLEND_FRACTION)) / BLEND_FRACTION);
		t = max(t_edge, t_density);
		if (t > 0.0) {
			next_sc = cascadeShadowCoord(cascade + 1, frag_pos_world, normal_offset_texels);
			if (cascadeEdgeTexels(cascade + 1, next_sc) <= cascadeFilterReach()
				|| next_sc.z <= 0.0 || next_sc.z >= 1.0)
				t = 0.0;
		}
	}

	// The PCSS penumbra floor ramps to the next cascade's texel size
	float pcss_min_spread = t > 0.0 ? lerp(1.0, cascadeNextTexelRatio(cascade), t) : 1.0;

	if (ubo.csm_blend_dithered == 2 && t > 0.0) {
		// Dithered: pick ONE cascade via noise, avoiding any second sample. Transposed so it
		// does not correlate with the PCSS disk rotation
		if (interleavedGradientNoise(pixel.yx) < t) {
			cascade = cascade + 1;
			sc = next_sc;
			pcss_min_spread = 1.0;
		}
		t = 0.0;
	}

	out_cascade = cascade;
	float2 rot = shadowDiskRotation(pixel);
	float shadow = sampleCascadeShadow(cascade, sc, rot, pcss_min_spread);

	// Linear blend: lerp with the next cascade in the band (2x sample cost)
	if (t > 0.0) {
		shadow = lerp(shadow, sampleCascadeShadow(cascade + 1, next_sc, rot, 1.0), t);
		out_blend = t;
	}

	// Fade out over the last stretch of the shadow distance
	const float FADE_FRACTION = 0.1;
	float fade = saturate((max_distance - frag_view_z) / (FADE_FRACTION * max_distance));
	return lerp(1.0, shadow, fade);
}

void calculatePointShadowTerms(float4 shadow_coords[MAX_SHADOW_LIGHTS], float2 pixel,
                                out float shadow_terms[MAX_SHADOW_LIGHTS],
                                out uint32_t shadow_for_light[MAX_SHADOW_LIGHTS]) {
	for (uint32_t s = 0; s < MAX_SHADOW_LIGHTS; s++) {
		shadow_terms[s] = 1.0;
		shadow_for_light[s] = 0xFFFFFFFF;
	}

	if (SHADOW_MODE_SPEC == ShadowMode::DISABLED) return;

	float2 rot = shadowDiskRotation(pixel);
	for (uint32_t shadow_idx = 0; shadow_idx < ubo.num_shadow_lights; shadow_idx++) {
		shadow_for_light[shadow_idx] = uint32_t(ubo.shadow_lights[shadow_idx].light_index_padding.x);

		float4 sc = shadow_coords[shadow_idx] / shadow_coords[shadow_idx].w;

		// Reject fragments outside the light's atlas region
		float4 bounds = ubo.shadow_lights[shadow_idx].atlas_bounds;
		if (sc.x < bounds.x || sc.x > bounds.z || sc.y < bounds.y || sc.y > bounds.w)
			continue;

		if (SHADOW_MODE_SPEC == ShadowMode::PCSS)
			shadow_terms[shadow_idx] = calculatePCSS(sc, rot);
		else if (SHADOW_MODE_SPEC == ShadowMode::REGULAR)
			shadow_terms[shadow_idx] = calculateShadowTerm(sc, float2(0.0, 0.0));
		else
			shadow_terms[shadow_idx] = calculateShadowPCF(sc);
	}
}

// Look up shadow term for a specific point light index
float getPointShadow(uint32_t light_index, float shadow_terms[MAX_SHADOW_LIGHTS],
                     uint32_t shadow_for_light[MAX_SHADOW_LIGHTS]) {
	for (uint32_t s = 0; s < ubo.num_shadow_lights; s++) {
		if (shadow_for_light[s] == light_index)
			return shadow_terms[s];
	}
	return 1.0;
}

#endif // VE_COMMON_NO_SCENE_SETS

float3 csmDebugColor(float3 albedo, uint cascade, float blend_t, float shadow) {
	static const float3 CASCADE_COLORS[4] = {
		float3(1.0, 0.2, 0.2),  // red
		float3(0.2, 1.0, 0.2),  // green
		float3(0.2, 0.2, 1.0),  // blue
		float3(1.0, 1.0, 0.2),  // yellow
	};
	float3 tint = CASCADE_COLORS[cascade % 4];
	if (blend_t > 0.0 && cascade < ubo.csm_cascade_count - 1)
		tint = lerp(tint, CASCADE_COLORS[(cascade + 1) % 4], blend_t);
	return albedo * tint * shadow;
}

float3 lodDebugColor(float3 albedo, uint lod_level) {
	static const float3 LOD_COLORS[4] = {
		float3(0.2, 1.0, 0.2),  // green  = LOD 0 (full detail)
		float3(1.0, 1.0, 0.2),  // yellow = LOD 1
		float3(1.0, 0.5, 0.2),  // orange = LOD 2
		float3(1.0, 0.2, 0.2),  // red    = LOD 3 (lowest detail)
	};
	return albedo * LOD_COLORS[min(lod_level, 3u)];
}

// meshlet_id is the draw's firstInstance: the instance index below MESHLET_COLOR_SHIFT and
// the meshlet's colour class above. Classes differ between meshlets that touch, so eight
// hues, alternating in brightness, with a darker tier per eight classes keep neighbours
// apart. The instance index turns the hue wheel per object.
float3 meshletDebugColor(float3 albedo, uint meshlet_id) {
	uint color_class = meshlet_id >> MESHLET_COLOR_SHIFT;
	uint h = meshlet_id & MESHLET_INSTANCE_MASK;
	h = ((h >> 16) ^ h) * 0x45d9f3bu;
	h = ((h >> 16) ^ h) * 0x45d9f3bu;
	h = (h >> 16) ^ h;
	float hue = float(color_class & 7u) / 8.0 + float(h & 0xFFFF) / 65536.0;
	float value = ((color_class & 1u) != 0u ? 0.4 : 0.85) / float(1u + min(color_class >> 3, 3u));
	float3 rgb = saturate(abs(frac(hue + float3(1.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0) - 1.0);
	return lerp(float3(1.0), rgb, 0.9) * value;
}


#endif
