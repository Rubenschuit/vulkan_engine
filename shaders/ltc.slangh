#include "ve_common.slangh"

static const float LTC_LUT_SIZE  = 64.0;
static const float LTC_LUT_SCALE = (LTC_LUT_SIZE - 1.0) / LTC_LUT_SIZE;
static const float LTC_LUT_BIAS  = 0.5 / LTC_LUT_SIZE;

float ltcIntegrateEdge(float3 v1, float3 v2) {
	float cos_theta = clamp(dot(v1, v2), -0.9999, 0.9999);
	float theta = acos(cos_theta);
	return cross(v1, v2).z * (theta / sin(theta));
}

// Clip the quad against the z=0 horizon.
void ltcClipQuadToHorizon(inout float3 L[5], out int n) {
	int config = 0;
	if (L[0].z > 0.0) config += 1;
	if (L[1].z > 0.0) config += 2;
	if (L[2].z > 0.0) config += 4;
	if (L[3].z > 0.0) config += 8;

	n = 0;
	if (config == 0) {
		// all below horizon
	} else if (config == 1) {
		n = 3;
		L[1] = -L[1].z * L[0] + L[0].z * L[1];
		L[2] = -L[3].z * L[0] + L[0].z * L[3];
	} else if (config == 2) {
		n = 3;
		L[0] = -L[0].z * L[1] + L[1].z * L[0];
		L[2] = -L[2].z * L[1] + L[1].z * L[2];
	} else if (config == 3) {
		n = 4;
		L[2] = -L[2].z * L[1] + L[1].z * L[2];
		L[3] = -L[3].z * L[0] + L[0].z * L[3];
	} else if (config == 4) {
		n = 3;
		L[0] = -L[3].z * L[2] + L[2].z * L[3];
		L[1] = -L[1].z * L[2] + L[2].z * L[1];
	} else if (config == 5) {
		n = 0; // impossible config
	} else if (config == 6) {
		n = 4;
		L[0] = -L[0].z * L[1] + L[1].z * L[0];
		L[3] = -L[3].z * L[2] + L[2].z * L[3];
	} else if (config == 7) {
		n = 5;
		L[4] = -L[3].z * L[0] + L[0].z * L[3];
		L[3] = -L[3].z * L[2] + L[2].z * L[3];
	} else if (config == 8) {
		n = 3;
		L[0] = -L[0].z * L[3] + L[3].z * L[0];
		L[1] = -L[2].z * L[3] + L[3].z * L[2];
		L[2] =  L[3];
	} else if (config == 9) {
		n = 4;
		L[1] = -L[1].z * L[0] + L[0].z * L[1];
		L[2] = -L[2].z * L[3] + L[3].z * L[2];
	} else if (config == 10) {
		n = 0; // impossible config
	} else if (config == 11) {
		n = 5;
		L[4] = L[3];
		L[3] = -L[2].z * L[3] + L[3].z * L[2];
		L[2] = -L[2].z * L[1] + L[1].z * L[2];
	} else if (config == 12) {
		n = 4;
		L[1] = -L[1].z * L[2] + L[2].z * L[1];
		L[0] = -L[0].z * L[3] + L[3].z * L[0];
	} else if (config == 13) {
		n = 5;
		L[4] = L[3];
		L[3] = L[2];
		L[2] = -L[1].z * L[2] + L[2].z * L[1];
		L[1] = -L[1].z * L[0] + L[0].z * L[1];
	} else if (config == 14) {
		n = 5;
		L[4] = -L[0].z * L[3] + L[3].z * L[0];
		L[0] = -L[0].z * L[1] + L[1].z * L[0];
	} else if (config == 15) {
		n = 4;
	}

	if (n == 3)
		L[3] = L[0];
	if (n == 4)
		L[4] = L[0];
}

float ltcEvaluate(float3 N, float3 V, float3 P, float3x3 Minv, float3 points[4], bool two_sided) {
	// Orthonormal basis aligned to V around N
	float3 T1 = normalize(V - N * dot(V, N));
	float3 T2 = cross(N, T1);
	float3x3 basis_t = float3x3(T1, T2, N);

	// Transform the rectangle vertices in this basis
	float3x3 M = mul(Minv, basis_t);

	float3 L[5];
	L[0] = mul(M, points[0] - P);
	L[1] = mul(M, points[1] - P);
	L[2] = mul(M, points[2] - P);
	L[3] = mul(M, points[3] - P);
	L[4] = L[3];

	int n;
	ltcClipQuadToHorizon(L, n);
	if (n == 0)
		return 0.0;

	L[0] = normalize(L[0]);
	L[1] = normalize(L[1]);
	L[2] = normalize(L[2]);
	L[3] = normalize(L[3]);
	L[4] = normalize(L[4]);

	float sum = 0.0;
	sum += ltcIntegrateEdge(L[0], L[1]);
	sum += ltcIntegrateEdge(L[1], L[2]);
	sum += ltcIntegrateEdge(L[2], L[3]);
	if (n >= 4) sum += ltcIntegrateEdge(L[3], L[4]);
	if (n == 5) sum += ltcIntegrateEdge(L[4], L[0]);

	sum = two_sided ? abs(sum) : max(sum, 0.0);
	return sum;
}

// Sampled from LTC LUTs
struct LtcTerms {
	float3x3 Minv;
	float4 mag;
	bool valid;
};

float3 ltcRectLight(RectLight rl, float3 N, float3 V, float3 P,
	float roughness, float3 F0, float3 diffuse_color, inout LtcTerms terms) {

	float3 to_center = rl.center.xyz - P;
	float radius = rl.center.w;
	float dist_sq = dot(to_center, to_center);
	if (radius > 0.0 && dist_sq >= radius * radius)
		return float3(0.0);

	float3 rh = rl.right_half.xyz;
	float3 uh = rl.up_half.xyz;
	if (dot(rh, rh) < 1e-8 || dot(uh, uh) < 1e-8)
		return float3(0.0);

	float3 c = rl.center.xyz;
	float3 pts[4];
	pts[0] = c - rh - uh;
	pts[1] = c + rh - uh;
	pts[2] = c + rh + uh;
	pts[3] = c - rh + uh;
	bool two_sided = rl.color.w > 0.5;

	if (!terms.valid) {
		float NdotV = clamp(dot(N, V), 0.0, 1.0);
		float2 uv = float2(roughness, sqrt(clamp(1.0 - NdotV, 0.0, 1.0)));
		uv = uv * LTC_LUT_SCALE + LTC_LUT_BIAS;
		float4 t1 = ltc_mat.SampleLevel(uv, 0);
		terms.mag = ltc_mag.SampleLevel(uv, 0);
		terms.Minv = float3x3(
			float3(t1.x, 0.0, t1.z),
			float3(0.0,  1.0, 0.0),
			float3(t1.y, 0.0, t1.w));
		terms.valid = true;
	}
	float3x3 identity = float3x3(
		float3(1.0, 0.0, 0.0),
		float3(0.0, 1.0, 0.0),
		float3(0.0, 0.0, 1.0));

	float spec = ltcEvaluate(N, V, P, terms.Minv, pts, two_sided);
	float diff = ltcEvaluate(N, V, P, identity, pts, two_sided);

	float3 fresnel = F0 * terms.mag.x + (1.0 - F0) * terms.mag.y;
	float3 radiance = rl.color.xyz;
	float3 col = radiance * (spec * fresnel + diffuse_color * diff);
	col /= (2.0 * PI);

	// Smooth falloff for finite range
	if (radius > 0.0) {
		float dr2 = dist_sq / (radius * radius);
		float w = saturate(1.0 - dr2 * dr2);
		col *= w * w;
	}
	return max(col, float3(0.0));
}

#endif
